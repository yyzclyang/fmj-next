{
  "name": "fmj-next",
  "private": true,
  "version": "0.0.1",
  "description": "伏魔记重写项目",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @fmj-next/core --filter @fmj-next/browser --filter @fmj-next/bbk-games run dev",
    "build": "pnpm --filter @fmj-next/core --filter @fmj-next/browser --filter @fmj-next/bbk-games run build",
    "build:packages": "pnpm --filter @fmj-next/core run build && pnpm --filter @fmj-next/browser run build",
    "dev:core": "pnpm --filter @fmj-next/core run dev",
    "dev:browser": "pnpm --filter @fmj-next/browser run dev",
    "dev:bbk-games": "pnpm run build:packages && pnpm --filter @fmj-next/bbk-games run dev",
    "build:core": "pnpm --filter @fmj-next/core run build",
    "build:browser": "pnpm --filter @fmj-next/browser run build",
    "build:bbk-games": "pnpm --filter @fmj-next/bbk-games run build",
    "lint": "pnpm -r exec prettier --write  \"**/*.{js,ts,json,tsx,css,scss,vue,html,md}\""
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "tsdown": "0.22.0",
    "typescript": "6.0.3"
  }
}
